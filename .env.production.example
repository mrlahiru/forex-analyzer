# =================================================================
# ForexAI Analyzer - Production Environment Variables Template
# Copy this file to .env before running `docker compose up --build -d`
# =================================================================

# Server & Runtime Configuration
PORT=5001
NODE_ENV=production
CLIENT_URL=http://localhost

# Database Configuration (Docker network container host)
MONGODB_URI=mongodb://mongodb:27017/forex-ai-analyzer

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production

# Market Data Providers (At least one recommended for live forex rates; fallback synthetic engine active if empty)
TWELVE_DATA_API_KEY=
OANDA_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# OpenAI Intelligence Synthesis (Optional: Fallback deterministic institutional engine active if empty)
OPENAI_API_KEY=

# Telegram Signal Alerts Engine (Optional: Live mock chat console active if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend Configuration
VITE_API_URL=/api
